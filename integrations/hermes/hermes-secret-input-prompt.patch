+# (title, destination) -> the value typed into a MASKED field, "" when declined or timed out. For tools and
+# plugins that store a secret somewhere other than Hermes's own sinks (an external vault over MCP, say): the
+# surface owns the field, the value goes to the caller's sink only, never to the model. ``destination`` names
+# where it goes (e.g. a sec:// ref) so the user can see that before typing.
+SecretInputPrompt = Callable[[str, str], str]
+
+
+def set_secret_input_prompt_callback(cb: Optional[SecretInputPrompt]) -> None:
+    """Register the surface's generic masked-input prompt, per thread."""
+    _callback_tls.secret_input = cb
+
+
+def get_secret_input_prompt_callback() -> Optional[SecretInputPrompt]:
+    return getattr(_callback_tls, "secret_input", None)
+
+
